# =============================================================================
# Snakemake Workflow: Public Procurement Control Surface
# =============================================================================
#
# Reproducible analysis pipeline for the GPRD (Global Procurement Research
# Dataset). The processed dataset (gprd_with_carbon.parquet) is available
# directly from Zenodo (DOI: 10.5281/zenodo.19456216 (concept) / 10.5281/zenodo.20823936 (version)); re-running the full
# acquisition pipeline is only required if you wish to rebuild from raw EU TED
# XML data (>90 GB) and Colombia SECOP OCDS exports.
#
# The current output of this repository is the Scientific Data Data Descriptor
# (Scientific_Data_Descriptor/). The `descriptor` target below builds it. The
# `all`/`verify` targets and the causal/projection rules below reproduce the
# earlier (superseded) analysis whose manuscript is in archive/old_manuscript_NC/.
#
# Usage (from repository root):
#   snakemake -j 1 descriptor   # Build + verify the Data Descriptor (current output)
#   snakemake -j 8 all          # Legacy full analysis pipeline
#   snakemake -j 1 verify       # Legacy claim-verification
#   snakemake --dag | dot -Tpdf > dag.pdf
#
# Requirements: Python >=3.10, packages in requirements.txt
# =============================================================================

from pathlib import Path

# ---------------------------------------------------------------------------
# Directories (relative to repository root)
# ---------------------------------------------------------------------------
RAW_DIR       = Path("Data/raw")
PROCESSED_DIR = Path("Data/processed")
RESULTS_DIR   = Path("results")
FIGURES_DIR   = Path("archive/old_manuscript_NC/NC_Submission/Main_Figures")

# ---------------------------------------------------------------------------
# Primary targets
# ---------------------------------------------------------------------------
rule all:
    """Run analysis pipeline and generate all manuscript figures."""
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet",
        RESULTS_DIR / "causal_id/callaway_santanna.json",
        RESULTS_DIR / "causal_id/staggered_did.json",
        RESULTS_DIR / "causal_id/sc_permutation_inference.json",
        RESULTS_DIR / "eu_ets/eu_context_si_tables.json",
        RESULTS_DIR / "core_stats/verified_statistics.json",
        RESULTS_DIR / "within_sector/within_supplier_analysis.json",
        RESULTS_DIR / "projections/oecd_calibrated_numbers.json",
        RESULTS_DIR / "projections/forward_projections.json",
        FIGURES_DIR / "Fig1_competition_carbon.pdf",
        FIGURES_DIR / "Fig2_rdd_competition.pdf",
        FIGURES_DIR / "Fig3_counterfactual.pdf",
        FIGURES_DIR / "Fig3_country_forest.pdf",
        FIGURES_DIR / "Fig4_mediation.pdf",

rule descriptor:
    """Build and verify the Scientific Data Data Descriptor (current output)."""
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet"
    shell:
        "python Scientific_Data_Descriptor/build_partA_panel.py && "
        "python Scientific_Data_Descriptor/si_make_tables.py && "
        "python Scientific_Data_Descriptor/make_figures.py && "
        "python Scientific_Data_Descriptor/verify_claims.py"

rule verify:
    """Verify all headline quantitative claims against stored result files (legacy)."""
    shell:
        "python archive/old_manuscript_NC/verify_all_claims.py"

# ---------------------------------------------------------------------------
# STAGE 1: Data processing (skip if using Zenodo dataset)
# ---------------------------------------------------------------------------
rule parse_eu_ted:
    """Parse raw EU TED XML exports to a standardised contract parquet."""
    output:
        PROCESSED_DIR / "ted_contracts.parquet"
    shell:
        "python scripts/pipeline/parse_eu_ted.py"

rule parse_colombia:
    """Parse Colombia SECOP OCDS JSONL export."""
    input:
        RAW_DIR / "secop_releases.jsonl"
    output:
        PROCESSED_DIR / "colombia_contracts.parquet"
    shell:
        "python scripts/pipeline/parse_ocds_jsonl.py"

rule harmonize:
    """Merge, deduplicate and standardise country datasets."""
    input:
        PROCESSED_DIR / "ted_contracts.parquet",
        PROCESSED_DIR / "colombia_contracts.parquet"
    output:
        PROCESSED_DIR / "gprd_master.parquet"
    shell:
        "python scripts/pipeline/harmonize_data.py"

rule link_carbon:
    """Assign EXIOBASE 3.8.2 carbon intensities via CPV-to-EXIOBASE crosswalk."""
    input:
        PROCESSED_DIR / "gprd_master.parquet",
        RAW_DIR / "EXIOBASE_3.8.2_2010-2022.xlsx"
    output:
        PROCESSED_DIR / "gprd_with_carbon.parquet"
    shell:
        "python scripts/pipeline/link_carbon_intensity.py"

# ---------------------------------------------------------------------------
# STAGE 2: Core statistics
# ---------------------------------------------------------------------------
rule core_stats:
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet"
    output:
        RESULTS_DIR / "core_stats/verified_statistics.json",
        RESULTS_DIR / "eu_ets/eu_context_si_tables.json"
    shell:
        "python archive/old_manuscript_NC/reproduce_manuscript_claims.py"

# ---------------------------------------------------------------------------
# STAGE 3: Causal identification
# ---------------------------------------------------------------------------
rule callaway_santanna:
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet"
    output:
        RESULTS_DIR / "causal_id/callaway_santanna.json"
    shell:
        "python scripts/causal_id/callaway_santanna.py"

rule staggered_did:
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet"
    output:
        RESULTS_DIR / "causal_id/staggered_did.json"
    shell:
        "python scripts/causal_id/staggered_did.py"

rule sc_permutation:
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet"
    output:
        RESULTS_DIR / "causal_id/sc_permutation_inference.json"
    shell:
        "python scripts/causal_id/sc_permutation_inference.py"

# ---------------------------------------------------------------------------
# STAGE 4: Within-sector triangulation
# ---------------------------------------------------------------------------
rule within_supplier:
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet"
    output:
        RESULTS_DIR / "within_sector/within_supplier_analysis.json"
    shell:
        "python scripts/within_sector/within_supplier_analysis.py"

# ---------------------------------------------------------------------------
# STAGE 5: Projections
# ---------------------------------------------------------------------------
rule oecd_calibration:
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet"
    output:
        RESULTS_DIR / "projections/oecd_calibrated_numbers.json"
    shell:
        "python scripts/projections/oecd_calibration.py"

rule forward_projections:
    input:
        RESULTS_DIR / "causal_id/callaway_santanna.json"
    output:
        RESULTS_DIR / "projections/forward_projections.json"
    shell:
        "python scripts/projections/forward_projections.py"

# ---------------------------------------------------------------------------
# STAGE 6: Figures
# ---------------------------------------------------------------------------
rule figures:
    input:
        PROCESSED_DIR / "gprd_with_carbon.parquet",
        RESULTS_DIR / "causal_id/callaway_santanna.json",
        RESULTS_DIR / "causal_id/sc_permutation_inference.json"
    output:
        FIGURES_DIR / "Fig1_competition_carbon.pdf",
        FIGURES_DIR / "Fig2_rdd_competition.pdf",
        FIGURES_DIR / "Fig3_counterfactual.pdf",
        FIGURES_DIR / "Fig3_country_forest.pdf",
        FIGURES_DIR / "Fig4_mediation.pdf"
    shell:
        "python scripts/figures/generate_manuscript_figures.py"
